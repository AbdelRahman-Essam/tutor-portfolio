# /etc/systemd/system/profile-backend.service
#
# Runs server/index.js as a supervised background service — starts on boot,
# restarts automatically if it crashes. Edit the paths/user below to match
# your server, then:
#
#   sudo cp deploy/profile-backend.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now profile-backend
#   sudo systemctl status profile-backend        # check it started
#   journalctl -u profile-backend -f             # tail its logs

[Unit]
Description=Profile portfolio login/edit backend
After=network.target

[Service]
Type=simple
User=trustech
WorkingDirectory=/home/trustech/projects/tutor-portfolio/server
EnvironmentFile=/home/trustech/projects/tutor-portfolio/server/.env
ExecStart=/usr/bin/node index.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
