# Copy to .env (and load it however you run the process — e.g. `node -r
# dotenv/config index.js`, or just `export` these in your shell/systemd unit)
# then fill in real values. Never commit the real .env.

# Required. Long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_JWT_SECRET=

# Optional. Defaults to 3000.
PORT=3000

# Set to "production" once you're serving over real HTTPS — this makes the
# session cookie Secure (HTTPS-only). Leave unset for local http://localhost
# testing.
NODE_ENV=

# Only needed for scripts/translate.js if you want to raise MyMemory's free
# daily translation quota (~5,000 words/day anonymous -> ~50,000/day with a
# registered email, still free: https://mymemory.translated.net/doc/keygen.php).
# Leave blank to just use the anonymous free tier.
MYMEMORY_EMAIL=
